<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coinly_surface"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Coinly.TopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="8dp">

        <ImageButton
            android:id="@+id/btnBackNews"
            style="@style/Widget.Coinly.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Artículo"
            android:textAppearance="@style/TextAppearance.Coinly.TopBarTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivDetailImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                tools:src="@drawable/img_news_ahorro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_info"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/coinly_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Ahorro" />

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Coinly.Heading"
                    tools:text="Título de la noticia" />

                <TextView
                    android:id="@+id/tvDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Coinly.Caption"
                    tools:text="12 Ago 2026" />

                <TextView
                    android:id="@+id/tvDetailBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textAppearance="@style/TextAppearance.Coinly.Body"
                    android:textSize="16sp"
                    tools:text="Contenido de la noticia" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenArticle"
                    style="@style/Widget.Coinly.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Abrir artículo completo"
                    app:icon="@drawable/ic_external"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
