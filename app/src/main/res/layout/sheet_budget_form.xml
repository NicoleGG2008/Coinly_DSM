<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvBudgetSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Coinly.Heading"
            android:text="Nuevo presupuesto" />

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/acBudgetCategory"
            android:text="Categoría" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBudgetCategory"
            style="@style/Widget.Coinly.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acBudgetCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Selecciona una categoría"
                android:inputType="none"
                android:minHeight="52dp"
                android:textSize="16sp"
                android:textColor="@color/coinly_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etBudgetLimit"
            android:text="Monto límite" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBudgetLimit"
            style="@style/Widget.Coinly.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:prefixText="$">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBudgetLimit"
                style="@style/Widget.Coinly.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBudgetCancel"
                style="@style/Widget.Coinly.Button.Outline.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBudgetSave"
                style="@style/Widget.Coinly.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Guardar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
