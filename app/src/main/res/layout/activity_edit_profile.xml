<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coinly_surface"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_navy"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/btnBackEditProfile"
            style="@style/Widget.Coinly.IconButton"
            android:layout_marginStart="-8dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:text="Editar perfil"
            android:textColor="@color/coinly_on_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Actualiza tus datos personales"
            android:textColor="@color/coinly_on_dark_muted"
            android:textSize="15sp" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Coinly.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etProfileName"
                android:text="Nombre completo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfileName"
                style="@style/Widget.Coinly.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileName"
                    style="@style/Widget.Coinly.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tu nombre"
                    android:inputType="textPersonName|textCapWords"
                    android:autofillHints="name"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Coinly.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etProfileEmail"
                android:text="Correo electrónico" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfileEmail"
                style="@style/Widget.Coinly.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileEmail"
                    style="@style/Widget.Coinly.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="tu@email.com"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Coinly.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etProfileUniversity"
                android:text="Universidad" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfileUniversity"
                style="@style/Widget.Coinly.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileUniversity"
                    style="@style/Widget.Coinly.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tu universidad"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Coinly.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etProfileCareer"
                android:text="Carrera" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfileCareer"
                style="@style/Widget.Coinly.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileCareer"
                    style="@style/Widget.Coinly.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tu carrera"
                    android:inputType="textCapWords"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Coinly.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/acProfileCurrency"
                android:text="Moneda local" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfileCurrency"
                style="@style/Widget.Coinly.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/acProfileCurrency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Selecciona una moneda"
                    android:inputType="none"
                    android:minHeight="52dp"
                    android:textSize="16sp"
                    android:textColor="@color/coinly_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                style="@style/Widget.Coinly.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Guardar cambios" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
