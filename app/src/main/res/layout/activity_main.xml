<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coinly_surface"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Hero con degradado de marca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/coinly_on_dark_muted"
                        android:textSize="14sp"
                        tools:text="Buenos días" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/coinly_on_dark"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Usuario 👋" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_glass"
                    android:contentDescription="@string/text_302"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tvHomeAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:gravity="center"
                        android:textColor="@color/coinly_on_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="U" />
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivHomeAvatarPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Coinly.Circle" />
                </FrameLayout>
            </LinearLayout>

            <!-- Tarjeta de saldo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_balance_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_303"
                    android:textAppearance="@style/TextAppearance.Coinly.Overline"
                    android:textColor="@color/coinly_on_dark_muted" />

                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Coinly.Display"
                    tools:text="$505.50" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_arrow_up"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/coinly_success"
                            android:gravity="center_vertical"
                            android:text="@string/text_304"
                            android:textColor="@color/coinly_on_dark_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvIncomeTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Coinly.Amount"
                            android:textColor="@color/coinly_chart_income"
                            tools:text="+$875.00" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/coinly_glass_border"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_arrow_down"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/coinly_chart_expense"
                            android:gravity="center_vertical"
                            android:text="@string/text_305"
                            android:textColor="@color/coinly_on_dark_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvExpenseTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Coinly.Amount"
                            android:textColor="@color/coinly_chart_expense"
                            tools:text="-$394.50" />
                    </LinearLayout>
                </LinearLayout>

                <com.example.coinly.ui.FlowChartView
                    android:id="@+id/flowChart"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_marginTop="16dp"
                    android:importantForAccessibility="yes" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Acciones rápidas -->
            <TextView
                style="@style/Coinly.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/text_306" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddIncome"
                    style="@style/Widget.Coinly.Button.Quick.Income"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="@string/text_307"
                    app:icon="@drawable/ic_arrow_up" />
                <Space android:layout_width="8dp" android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddExpense"
                    style="@style/Widget.Coinly.Button.Quick.Expense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="@string/text_308"
                    app:icon="@drawable/ic_arrow_down" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewHistory"
                    style="@style/Widget.Coinly.Button.Quick.History"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="@string/text_309"
                    app:icon="@drawable/ic_dollar" />
                <Space android:layout_width="8dp" android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewBudgets"
                    style="@style/Widget.Coinly.Button.Quick.Budgets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="@string/text_015"
                    app:icon="@drawable/ic_pie" />
            </LinearLayout>

            <!-- Alertas: muestra banners o el mensaje de "sin alertas" -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Coinly.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_310" />

                <TextView
                    android:id="@+id/tvClearAlertsHome"
                    style="@style/Coinly.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/text_311" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- Movimientos recientes -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Coinly.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_312" />

                <TextView
                    android:id="@+id/tvViewAllMovements"
                    style="@style/Coinly.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/text_313" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRecentMovements"
                style="@style/Coinly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="8dp" />

            <!-- Presupuestos -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Coinly.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_314" />

                <TextView
                    android:id="@+id/tvViewAllBudgets"
                    style="@style/Coinly.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/text_313" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutBudgetsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
