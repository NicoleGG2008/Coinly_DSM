<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/editorContent" android:focusableInTouchMode="true" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/coinly_surface">
 <LinearLayout style="@style/Coinly.TopBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:padding="12dp">
  <ImageButton android:id="@+id/editorBack" style="@style/Widget.Coinly.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/news_back" app:tint="@color/coinly_on_dark" />
  <TextView android:id="@+id/editorHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/economic_add" android:textColor="@color/coinly_on_dark" android:textSize="22sp" android:textStyle="bold" android:accessibilityHeading="true" />
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/economic_explanation" android:textColor="@color/coinly_text_secondary" android:textSize="14sp" android:layout_marginBottom="20dp" />
   <TextView android:id="@+id/economicSessionHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/economic_remember" android:textColor="@color/coinly_text_secondary" android:layout_marginBottom="16dp" />
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEconomicTitle" style="@style/Widget.Coinly.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:hint="@string/economic_title" app:hintEnabled="true" app:counterEnabled="true" app:counterMaxLength="500" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/economicTitle" style="@style/Widget.Coinly.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="500" android:minLines="1" android:gravity="top|start" android:inputType="textCapSentences" />
   </com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEconomicType" style="@style/Widget.Coinly.TextInputLayout.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:hint="@string/economic_type" app:hintEnabled="true" app:counterEnabled="false" app:counterMaxLength="30" >
    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/economicType" style="@style/Widget.Coinly.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="30" android:minLines="1" android:gravity="top|start" android:inputType="none" />
   </com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEconomicAmount" style="@style/Widget.Coinly.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:hint="@string/economic_amount" app:hintEnabled="true" app:counterEnabled="true" app:counterMaxLength="20" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/economicAmount" style="@style/Widget.Coinly.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="20" android:minLines="1" android:gravity="top|start" android:inputType="numberDecimal" />
   </com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEconomicCategory" style="@style/Widget.Coinly.TextInputLayout.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:hint="@string/economic_category" app:hintEnabled="true" app:counterEnabled="false" app:counterMaxLength="100" >
    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/economicCategory" style="@style/Widget.Coinly.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="100" android:minLines="1" android:gravity="top|start" android:inputType="none" />
   </com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEconomicDate" style="@style/Widget.Coinly.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:hint="@string/economic_date" app:hintEnabled="true" app:counterEnabled="true" app:counterMaxLength="10" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/economicDate" style="@style/Widget.Coinly.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="10" android:minLines="1" android:gravity="top|start" android:inputType="none" android:focusable="false" android:clickable="true" />
   </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@color/coinly_card">
  <TextView android:id="@+id/editorError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coinly_danger_text" android:accessibilityLiveRegion="polite" android:visibility="gone" android:layout_marginBottom="8dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/editorSave" style="@style/Widget.Coinly.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/economic_save" />
  <com.google.android.material.button.MaterialButton android:id="@+id/economicViewMovement" style="@style/Widget.Coinly.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/economic_view" android:visibility="gone" />
  <com.google.android.material.button.MaterialButton android:id="@+id/economicDelete" style="@style/Widget.Coinly.Button.Outline.Danger" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/economic_delete" android:visibility="gone" />
 </LinearLayout>
</LinearLayout>
