<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Coinly.Heading"
            android:text="@string/text_316" />

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_377" />

        <LinearLayout
            android:id="@+id/toggleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeIncome"
                style="@style/Widget.Coinly.Button.TypeIncome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/text_070"
                app:icon="@drawable/ic_arrow_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeExpense"
                style="@style/Widget.Coinly.Button.TypeExpense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:checkable="true"
                android:checked="true"
                android:text="@string/text_071"
                app:icon="@drawable/ic_arrow_down" />
        </LinearLayout>

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etAmount"
            android:text="@string/text_378" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAmount"
            style="@style/Widget.Coinly.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:prefixText="$">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                style="@style/Widget.Coinly.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_322"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/acCategory"
            android:text="@string/text_072" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategory"
            style="@style/Widget.Coinly.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_366"
                android:inputType="none"
                android:minHeight="52dp"
                android:textSize="16sp"
                android:textColor="@color/coinly_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etDescription"
            android:text="@string/text_379" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescription"
            style="@style/Widget.Coinly.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                style="@style/Widget.Coinly.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_380"
                android:inputType="textCapSentences"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etDate"
            android:text="@string/text_073" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDate"
            style="@style/Widget.Coinly.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconContentDescription="Elegir fecha">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                style="@style/Widget.Coinly.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_381"
                android:inputType="none"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/acPayment"
            android:text="@string/text_382" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPayment"
            style="@style/Widget.Coinly.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_383"
                android:inputType="none"
                android:minHeight="52dp"
                android:textSize="16sp"
                android:textColor="@color/coinly_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Coinly.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etTags"
            android:text="@string/text_384" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTags"
            style="@style/Widget.Coinly.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTags"
                style="@style/Widget.Coinly.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_385"
                android:inputType="text"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetCancel"
                style="@style/Widget.Coinly.Button.Outline.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/text_368" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetSave"
                style="@style/Widget.Coinly.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/text_065" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
