<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/logoContainer"
                android:layout_width="300dp"
                android:layout_height="190dp"
                android:clickable="true"
                android:contentDescription="@string/text_262"
                android:focusable="true">

                <View
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_welcome_glow"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/imgCoinlyIcon"
                    android:layout_width="120dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/coinly_icon" />

                <ImageView
                    android:id="@+id/imgCoinlyLogo"
                    android:layout_width="280dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/coinly_logo"
                    android:visibility="invisible" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/text_263"
                android:textColor="@color/coinly_on_dark_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTapHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.04"
                android:text="@string/text_264"
                android:textColor="@color/coinly_on_dark_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegister"
        style="@style/Widget.Coinly.Button.Green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_265" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        style="@style/Widget.Coinly.Button.Outline.OnDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/text_266" />
</LinearLayout>
