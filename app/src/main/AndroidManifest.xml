<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CoinlyApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coinly">

        <!-- 1. La app inicia en la pantalla de Bienvenida -->
        <activity android:configChanges="orientation|screenSize|smallestScreenSize"
            android:name=".BienvenidaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Autenticación y cuenta (adjustResize: el teclado no tapa los campos) -->
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".ForgotPasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".ChangePasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".EditProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 3. Pantalla principal y secciones -->
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".MainActivity" android:exported="false" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".MovimientosActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".PresupuestosActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".NoticiasActivity" android:exported="false" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".NoticiaDetalleActivity" android:exported="false" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".EducacionActivity" android:exported="false" />
        <activity android:configChanges="orientation|screenSize|smallestScreenSize" android:name=".PerfilActivity" android:exported="false" />
    </application>

</manifest>
